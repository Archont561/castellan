{
  "name": "@castellan/ui",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "Shared Svelte components for the desktop and mobile faces",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./uno": "./uno.ts"
  },
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "lint": "biome check src",
    "test": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@castellan/protocol": "workspace:*"
  },
  "devDependencies": {
    "@castellan/utils": "workspace:*",
    "@playwright/experimental-ct-svelte": "1.58.2",
    "@playwright/test": "1.58.2",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/svelte-vite": "^10.6.1",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "storybook": "^10.6.1",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.9.0",
    "unocss": "^66.10.5",
    "vite": "^6.3.5"
  }
}
