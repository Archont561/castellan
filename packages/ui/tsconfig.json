{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@castellan/utils/tsconfig/lib.json",
  "compilerOptions": {
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.ts",
    ".storybook/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
