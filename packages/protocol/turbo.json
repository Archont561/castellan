{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // Wire types and all face clients are produced by the Rust workspace's
    // codegen task; a typecheck that skips it sees a stale RPC surface.
    "build": { "dependsOn": ["@castellan/rust#codegen"] },
    "typecheck": { "dependsOn": ["@castellan/rust#codegen"] },
    "test": { "dependsOn": ["@castellan/rust#codegen"] }
  }
}
