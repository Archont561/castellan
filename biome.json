{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.json",
      "**/*.jsonc",
      "**/*.svelte",
      "!.devcontainer",
      "!.github",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!**/.pixi",
      "!**/.turbo",
      "!**/.venv",
      "!**/.wxt",
      "!**/.output",
      "!**/.cache",
      "!**/storybook-static",
      "!**/test-results",
      "!**/playwright-report",
      "!**/blob-report",
      "!**/.playwright-cli",
      "!**/.svelte-kit",
      "!**/src/pkg",
      "!**/src-tauri/gen",
      "!**/build",
      "!**/.astro",
      "!**/src/generated",
      "!apps/extension/native-hosts/generated",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useNamingConvention": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", "../"],
                "message": "Climbing out of a directory with `../` is not how this repo resolves siblings: use the `@` alias, which points at your package or app root (`@/src/components/X.svelte`, `@/src/fixtures`). The one exception is a shared package's own `src/`, which keeps `./`-relative imports because `@` would resolve against the consuming app there — see AGENTS.md."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/utils/tsconfig/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ]
}
