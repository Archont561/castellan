{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    "packages/utils/tsconfig/*.json",
    "Cargo.toml",
    "Cargo.lock",
    "deny.toml"
  ],
  "globalEnv": ["CASTELLAN_VERSION"],
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    "XDG_CACHE_HOME",
    "CARGO_HOME",
    "PIXI_ENVIRONMENT",
    "CARGO_NET_OFFLINE",
    "CARGO_TARGET_*",
    "RUSTFLAGS",
    "RUSTDOCFLAGS"
  ],
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".wxt/**", "src/pkg/**"]
    },
    "e2e": {
      "outputs": ["playwright-report/**", "test-results/**", "blob-report/**"],
      "cache": false
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "cov": {
      "dependsOn": ["^build"],
      "outputs": ["lcov.info"]
    },
    "fmt": {
      "cache": false
    },
    "advisories": {
      "cache": false
    },
    "//#lint:biome": {
      "inputs": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,svelte}", "biome.json"]
    },
    "//#lint:workflows": {
      "inputs": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    },
    "//#fmt:biome": {
      "cache": false
    }
  }
}
